# syntax=docker/dockerfile:1.4

FROM node:24.18.0-alpine AS frontend-builder

WORKDIR /frontend
RUN apk add --no-cache bash curl git tar \
    && corepack enable
COPY --from=autofilm_frontend . .
RUN --mount=type=cache,id=autofilm-openlist-pnpm,target=/root/.local/share/pnpm/store \
    OPENLIST_FRONTEND_VERSION_OVERRIDE=v4.2.4 \
    bash build.sh --dev --skip-i18n --no-compress

FROM golang:1.26.4-alpine AS builder

WORKDIR /app
RUN apk add --no-cache bash curl gcc git jq musl-dev
COPY go.mod go.sum ./
RUN --mount=type=cache,id=autofilm-openlist-go-mod,target=/go/pkg/mod \
    go mod download
COPY . .
COPY --from=frontend-builder /frontend/dist ./public/dist
RUN --mount=type=cache,id=autofilm-openlist-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=autofilm-openlist-go-build,target=/root/.cache/go-build \
    AUTOFILM_USE_BUNDLED_FRONTEND=true \
    AUTOFILM_FRONTEND_VERSION=autofilm \
    bash build.sh release docker

FROM openlistteam/openlist-base-image:base

ARG USER=openlist
ARG UID=1001
ARG GID=1001

WORKDIR /opt/openlist
RUN addgroup -g "${GID}" "${USER}" \
    && adduser -D -u "${UID}" -G "${USER}" "${USER}" \
    && mkdir -p /opt/openlist/data

COPY --from=builder /app/bin/openlist ./
COPY entrypoint.sh /entrypoint.sh
RUN chown "${UID}:${GID}" /opt/openlist/openlist /entrypoint.sh \
    && chmod 755 /opt/openlist/openlist /entrypoint.sh

USER ${USER}
ENV UMASK=022
VOLUME /opt/openlist/data
EXPOSE 5244 5245
ENTRYPOINT ["/entrypoint.sh"]
